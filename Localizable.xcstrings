    "command.stay.desc" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensenya al teu gos a quedar-se quiet fins que l'alliberis"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teach your dog to stay in place until released"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enseña a tu perro a quedarse quieto hasta que lo liberes"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навчіть пса залишатися на місці до команди звільнення"
          }
        }
      }
    },
    "command.stay.step1" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demana primer al gos que segui"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask your dog to sit first"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide primero al perro que se siente"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спочатку попросіть пса сісти"
          }
        }
      }
    },
    "command.stay.step2" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre el palmell i digues 'Quiet'"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open your palm and say 'Stay'"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la palma y di 'Quieto'"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте долоню і скажіть 'Чекати'"
          }
        }
      }
    },
    "command.stay.step3" : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recula a poc a poc, torna i recompensa"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Step back slowly, then return and reward"
          }
