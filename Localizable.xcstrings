      }
    },
    "command.leave.desc" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Teach your dog to ignore something on cue" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Enseña a tu perro a ignorar algo a la orden" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Ensenya al teu gos a ignorar quelcom a l'ordre" } }
      }
    },
