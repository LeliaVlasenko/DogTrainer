    "command.sit.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sit" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sentado" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Seu" } }
      }
    },
    "command.sit.desc" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The most basic command — teach your dog to sit on cue" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El comando más básico: enseña a tu perro a sentarse" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "L'ordre més bàsica: ensenya al teu gos a seure" } }
      }
    },
    "command.sit.step1" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold a treat just above your dog's nose" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sostén un premio justo encima de la nariz del perro" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Sosté un premi just damunt del nas del gos" } }
      }
    },
    "command.sit.step2" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Slowly move it backward over their head" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Muévelo lentamente hacia atrás sobre la cabeza" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Mou-lo lentament cap enrere sobre el cap" } }
      }
    },
    "command.sit.step3" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "When they sit, say 'Sit!' and reward immediately" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Cuando se siente, di '¡Sentado!' y recompensa al instante" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Quan segui, digues 'Seu!' i recompensa de seguida" } }
      }
    },
    "command.stay.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stay" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Quieto" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Quiet" } }
      }
    },
    "command.stay.desc" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Teach your dog to stay in place until released" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Enseña a tu perro a quedarse quieto hasta que lo liberes" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Ensenya al teu gos a quedar-se quiet fins que l'alliberis" } }
      }
    },
    "command.stay.step1" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ask your dog to sit first" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Pide primero al perro que se siente" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Demana primer al gos que segui" } }
      }
    },
    "command.stay.step2" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open your palm and say 'Stay'" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre la palma y di 'Quieto'" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Obre el palmell i digues 'Quiet'" } }
      }
    },
    "command.stay.step3" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Step back slowly, then return and reward" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Retrocede despacio, vuelve y recompensa" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Recula a poc a poc, torna i recompensa" } }
      }
    },
    "command.come.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Come" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ven" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Vine" } }
      }
    },
    "command.come.desc" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Teach your dog to come when called" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Enseña a tu perro a venir cuando lo llames" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Ensenya al teu gos a venir quan el cridis" } }
      }
    },
    "command.come.step1" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Crouch down and say their name + 'Come!'" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Agáchate y di su nombre + '¡Ven!'" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Ajup-te i digues el seu nom + 'Vine!'" } }
      }
    },
    "command.come.step2" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reward enthusiastically when they reach you" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Recompensa con entusiasmo cuando llegue" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Recompensa amb entusiasme quan arribi" } }
      }
    },
    "command.down.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Down" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Echado" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Ajagut" } }
      }
    },
    "command.down.desc" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Teach your dog to lie down on cue" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Enseña a tu perro a echarse a la orden" } },
        "ca" : { "stringUnit" : { "state" : "translated", "value" : "Ensenya al teu gos a ajeure's a l'ordre" } }
      }
    },
    "command.leave.title" : {
      "localizations" : {
